COMPOSE_PROJECT_NAME=mariachi-dev
ENVIRONMENT=development

API_PORT=<port>
ADMIN_PORT=<port>

POSTGRES_USER=<user>
POSTGRES_PASSWORD=<password>
POSTGRES_DB=<db_name>
DATABASE_URL=postgresql://<user>:<password>@<postgres_host>:<port>/<db_name>

# DataEngine (solo para modulo de capas de MapaLab)
DATAENGINE_DATABASE_URL=postgresql://<user>:<password>@<dataengine_host>:<port>/<db_name>
DATAENGINE_POOL_SIZE=5
DATAENGINE_MAX_OVERFLOW=5

# GeoServer REST
GEOSERVER_URL=http://<geoserver_host>:<port>/geoserver/
GEOSERVER_USER=<user>
GEOSERVER_PASSWORD=<password>
GEOSERVER_TIMEOUT=10.0

REDIS_URL=redis://<redis_host>:<port>/0

# Acervo (S3/MinIO). Las URLs se persisten como `bucket/path` y se resuelven
# a absolutas con `{scheme}://{ACERVO_PUBLIC_ENDPOINT}/{bucket}/{path}` al
# devolverlas al cliente, asi que cambiar el host no requiere migrar datos.
#
# Opcion A — apuntar a un acervo remoto (prod/staging IIEG):
#   ACERVO_ENDPOINT=<acervo_host>:<port>
#   ACERVO_PUBLIC_ENDPOINT=<acervo_public_host>:<port>
#   ACERVO_USE_SSL=true
#
# Opcion B — apuntar al MinIO local (`acervo-minio-dev`, expuesto en :9000).
# Antes de usar: crea los buckets `portal` y `mapalab` con `mc mb` y, si vas a
# servir las imagenes desde el navegador, dale anonymous read:
#   docker exec acervo-minio-dev mc alias set local http://localhost:9000 <u> <p>
#   docker exec acervo-minio-dev mc mb -p local/portal local/mapalab
#   docker exec acervo-minio-dev mc anonymous set download local/mapalab
#   ACERVO_ENDPOINT=acervo-minio-dev:9000
#   ACERVO_PUBLIC_ENDPOINT=localhost:9000
#   ACERVO_USE_SSL=false
ACERVO_ENDPOINT=<acervo_host>:<port>
ACERVO_PUBLIC_ENDPOINT=<acervo_public_host>:<port>
ACERVO_USE_SSL=false
ACERVO_VERIFY_SSL=false

# Credenciales por bucket. Cada bucket activo en `media_buckets` requiere
# su par <REF>_ACCESS_KEY / <REF>_SECRET_KEY. Generar/rotar con:
#   cd ../acervo && ./scripts/init-buckets.sh --rotate
ACERVO_PORTAL_ACCESS_KEY=portal-user
ACERVO_PORTAL_SECRET_KEY=
ACERVO_MAPALAB_ACCESS_KEY=mapalab-user
ACERVO_MAPALAB_SECRET_KEY=
ACERVO_MARIACHI_ACCESS_KEY=mariachi-user
ACERVO_MARIACHI_SECRET_KEY=
ACERVO_SIEEJ_ACCESS_KEY=sieej-diccionarios-user
ACERVO_SIEEJ_SECRET_KEY=

SECRET_KEY=<genera_con_secrets.token_urlsafe(32)>
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
CSRF_SECRET_KEY=<genera_con_secrets.token_urlsafe(32)>
CSRF_TOKEN_EXPIRE_MINUTES=60

COOKIE_NAME=access_token
COOKIE_MAX_AGE=1800
COOKIE_DOMAIN=
COOKIE_SECURE=false
COOKIE_HTTPONLY=true
COOKIE_SAMESITE=lax

CORS_ORIGINS=["http://<host>:<admin_port>","http://<host>:<portal_port>"]

PROJECT_NAME="Mariachi Dev"
VERSION="1.0.0"
ADMIN_PREFIX=/api/administrador
WEB_PREFIX=/api/portal
MAPALAB_PUBLIC_PREFIX=/api/mapalab
DOCS_URL=/docs
REDOC_URL=/redoc
OPENAPI_URL=/openapi.json

VITE_NODE_ENV=development
VITE_GOOGLE_ANALYTICS_ID=<GA_ID_or_empty>
VITE_ADMIN_PORT=<port>
VITE_ADMIN_HOST=<host>
VITE_ADMIN_APP_NAME="Mariachi Dev"
VITE_ADMIN_API_URL=http://<api_host>:<port>/api/administrador
VITE_ADMIN_API_TIMEOUT=10000

# URL del frontend de MapaLab para el proxy Vite del admin en dev.
VITE_MAPALAB_PROXY_URL=http://<mapalab_frontend_host>:<port>

# URL del backend de MapaLab al que mariachi-api notifica refresh-cache.
# Si queda vacio, layer_tree_cache no se invalida hasta el cron diario.
MAPALAB_BACKEND_URL=http://<mapalab_backend_host>:<port>
# Token compartido con MAPALAB_INTERNAL_TOKEN del backend mapalab para crear shares permanentes
MAPALAB_INTERNAL_TOKEN=<genera_con_secrets.token_urlsafe(32)>

# URL del frontend de SIEEJ para el dashboard de plataformas en `/inicio`.
# Si queda vacio, sieej se muestra como "no integrada" en la card de plataformas.
SIEEJ_URL=

# Endpoints `/ontoy` de cada plataforma del ecosistema. Se consultan desde el
# dashboard `/inicio` para detectar version y healthy. En dev solo dataengine
# expone el endpoint (servicio version-api en :8088); el resto vive detras de
# su nginx propio que solo se levanta en staging/production. En dev las que no
# respondan reportan healthy=false pero la card sigue mostrando el `static_version`
# que `platforms_config.py` mantiene sincronizado con su CHANGELOG.
SIEEJ_ONTOY_URL=
DATAENGINE_ONTOY_URL=http://<dataengine_version_api_host>:<port>/ontoy
ACERVO_ONTOY_URL=
GATEWAY_HUB_ONTOY_URL=
HUACHICOL_ONTOY_URL=
GEOSERVER_ONTOY_URL=

ADMIN_USERNAME=<admin_username>
ADMIN_PASSWORD=<admin_password>
ADMIN_EMAIL=<admin_email>

CREATE_SAMPLE_USERS=true
SAMPLE_EDITORA_PASSWORD=<password>
SAMPLE_DISENADORA_PASSWORD=<password>

# Sentry (opcional; si vacio no se inicializa)
VITE_SENTRY_DSN=
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=1.0
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
