COMPOSE_PROJECT_NAME=mariachi-dev
ENVIRONMENT=development

API_PORT=<port>
ADMIN_PORT=<port>

POSTGRES_USER=<user>
POSTGRES_PASSWORD=<password>
POSTGRES_DB=<db_name>

DATAENGINE_DATABASE_URL=postgresql://<user>:<password>@<dataengine_host>:<port>/<db_name>

GEOSERVER_URL=http://<sextante_host>:<port>/sextante/
GEOSERVER_USER=<user>
GEOSERVER_PASSWORD=<password>
# Staging en disco de las subidas por partes a GeoServer (rasters, tipografias).
# GEOSERVER_UPLOAD_MAX_BYTES=0 significa sin tope: el techo es el disco de la VM.
GEOSERVER_UPLOAD_STAGING_DIR=/var/tmp/geoserver-uploads
GEOSERVER_UPLOAD_MAX_BYTES=0
GEOSERVER_INSTALLED_FONT_FAMILIES=Garet

ACERVO_ENDPOINT=<acervo_host>:<port>
ACERVO_PUBLIC_ENDPOINT=<acervo_public_host>:<port>
ACERVO_USE_SSL=false
ACERVO_VERIFY_SSL=false

ACERVO_PORTAL_ACCESS_KEY=portal-user
ACERVO_PORTAL_SECRET_KEY=
ACERVO_MAPALAB_ACCESS_KEY=mapalab-user
ACERVO_MAPALAB_SECRET_KEY=
ACERVO_MARIACHI_ACCESS_KEY=mariachi-user
ACERVO_MARIACHI_SECRET_KEY=
ACERVO_SIEEJ_ACCESS_KEY=sieej-user
ACERVO_SIEEJ_SECRET_KEY=
ACERVO_IIEG_ACCESS_KEY=iieg-user
ACERVO_IIEG_SECRET_KEY=

SECRET_KEY=<genera_con_secrets.token_urlsafe(32)>
CSRF_SECRET_KEY=<genera_con_secrets.token_urlsafe(32)>

# Minerva (SSO). MINERVA_ISSUER_URL es la URL con que la alcanza el backend;
# MINERVA_PUBLIC_URL la que alcanza el navegador (vacia si son la misma).
# MINERVA_REDIRECT_URI debe coincidir EXACTA con la registrada en minerva.
MINERVA_ISSUER_URL=http://<minerva_host>:<port>
MINERVA_PUBLIC_URL=
MINERVA_APPLICATION_CODE=mariachi
MINERVA_CLIENT_ID=<client_id_de_la_app_en_minerva>
MINERVA_CLIENT_SECRET=<client_secret_de_la_app_en_minerva>
MINERVA_REDIRECT_URI=http://<api_host>:<port>/api/mariachi/autenticacion/callback
# Opcional: client_id de la app SIEEJ, para que minerva muestre su marca cuando el
# acceso viene de /sieej. Vacia = siempre marca mariachi.
MINERVA_SIEEJ_BRANDING_CLIENT_ID=
MINERVA_LOGIN_URL=
MINERVA_POST_LOGIN_URL=http://<host>:<admin_port>/

CORS_ORIGINS=["http://<host>:<admin_port>","http://<host>:<portal_port>"]

ADMIN_USERNAME=<admin_username>
ADMIN_PASSWORD=<admin_password>
ADMIN_EMAIL=<admin_email>

CREATE_SAMPLE_USERS=true
SAMPLE_EDITORA_PASSWORD=<password>
SAMPLE_DISENADORA_PASSWORD=<password>

VITE_MAPALAB_PROXY_URL=http://<mapalab_frontend_host>:<port>

MAPALAB_BACKEND_URL=http://<mapalab_backend_host>:<port>
MAPALAB_INTERNAL_TOKEN=<genera_con_secrets.token_urlsafe(32)>

# Token para subida interna al Acervo desde plataformas externas (Portal). Solo bucket `portal`.
ACERVO_INTERNAL_TOKEN=<genera_con_secrets.token_urlsafe(32)>

DISCORD_WEBHOOK_MAPALAB=
DISCORD_WEBHOOK_SIEEJ=
DISCORD_WEBHOOK_PORTAL=

SIEEJ_URL=
# true congela en la API toda escritura de envios de SIEEJ (equivale a VITE_DISABLED_EDITION del cliente)
SIEEJ_EDICION_DESHABILITADA=<true|false>

# Colibri (botón "Reportar" en cards de plataformas del Inicio del admin).
# Crear o rotar la api-key del source-app "mariachi" desde /colibri/source-apps,
# y pegar el valor aquí. Si queda vacío, el botón no se renderiza.
COLIBRI_API_KEY_MARIACHI=

VITE_ADMIN_API_URL=http://<api_host>:<port>/api/mariachi
VITE_WEB_URL=http://<host>:<portal_port>

VITE_NODE_ENV=development
VITE_APP_ENV=dev
VITE_CARTO_API_KEY=<key-de-carto-basemaps>
CRON_SIEEJ_EXPIRE_INTERVAL=3600

# Monitor ligero de huachicol (estado del ecosistema via /ontoy)
HUACHICOL_MONITOR_URL=http://huachicol-monitor:8090

FRAMES_ENABLED=false
FRAMES_API_URL=<http://IP:PUERTO de la API de frames; solo en el nodo donde vive>
FRAMES_TIMEOUT=10
FRAMES_DETECT_FPS=15
# Usuario del restream RTSP (8554) de frames; la clave es FRIGATE_RTSP_PASSWORD del .env de frames
FRAMES_RTSP_USERNAME=<usuario del restream RTSP de frames>

# Administracion del contenido de la intranet. Apagado deja el router sin registrar (404).
# La clave sale de `make mariachi-key` en intranet; alla se guarda solo su huella.
INTRANET_ENABLED=false
INTRANET_API_URL=<http://IP:PUERTO del nginx de intranet; solo en el nodo que la alcanza>
INTRANET_API_KEY=<api key de servicio de intranet>
INTRANET_TIMEOUT=20

# Huella SHA-256 de la clave con la que intranet lee el roadmap y manda su telemetria
# (/api/public/roadmap y /api/public/intranet/events/batch). Vacia apaga los dos: 401 a todo.
INTRANET_CLIENTE_SHA256=<sha256 de la clave de intranet (make mariachi-cliente-key en intranet), o vacía>
POSTGRES_BIND_ADDR=<ip-de-bind-de-postgres>
REDIS_BIND_ADDR=<ip-de-bind-de-redis>
API_BIND_ADDR=<ip-de-bind-de-la-api>
ADMIN_BIND_ADDR=<ip-de-bind-del-admin>
POSTGRES_MAX_CONNECTIONS=<int>
POSTGRES_SHARED_BUFFERS=<ej-128MB>
POSTGRES_EFFECTIVE_CACHE_SIZE=<ej-512MB>
