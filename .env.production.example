COMPOSE_PROJECT_NAME=mariachi
ENVIRONMENT=production

POSTGRES_USER=<user>
POSTGRES_PASSWORD=<password>
POSTGRES_DB=<db_name>
DATABASE_URL=postgresql://<user>:<password>@<postgres_host>:<port>/<db_name>

# DataEngine (solo para modulo de capas de MapaLab)
DATAENGINE_DATABASE_URL=postgresql://<user>:<password>@<dataengine_host>:<port>/<db_name>?sslmode=require
DATAENGINE_POOL_SIZE=5
DATAENGINE_MAX_OVERFLOW=5

# GeoServer REST
GEOSERVER_URL=https://<domain>/geoserver/
GEOSERVER_USER=<user>
GEOSERVER_PASSWORD=<password>
GEOSERVER_TIMEOUT=10.0

# URL interna del backend de mapalab para invalidar el cache del arbol.
MAPALAB_BACKEND_URL=http://<mapalab_backend_host>:<port>

REDIS_URL=redis://<redis_host>:<port>/0

ACERVO_ENDPOINT=<acervo_host>:<port>
ACERVO_PUBLIC_ENDPOINT=<acervo_public_domain>/acervo
ACERVO_USE_SSL=true
ACERVO_VERIFY_SSL=true

# Credenciales por bucket. Mariachi NO hace fallback al usuario root del cluster
# MinIO (principio de menor privilegio). Cada bucket activo en `media_buckets`
# requiere su par <REF>_ACCESS_KEY / <REF>_SECRET_KEY donde <REF> coincide con
# el `access_key_ref` de la fila en BD.
#
# Para generar/rotar las creds en acervo:
#   cd ../acervo && ./scripts/init-buckets.sh             (al primer deploy)
#   cd ../acervo && ./scripts/init-buckets.sh --rotate    (rotar todas)
#   cd ../acervo && ./scripts/init-buckets.sh --rotate <bucket>
ACERVO_PORTAL_ACCESS_KEY=portal-user
ACERVO_PORTAL_SECRET_KEY=<rotada_por_init-buckets>
ACERVO_MAPALAB_ACCESS_KEY=mapalab-user
ACERVO_MAPALAB_SECRET_KEY=<rotada_por_init-buckets>
ACERVO_MARIACHI_ACCESS_KEY=mariachi-user
ACERVO_MARIACHI_SECRET_KEY=<rotada_por_init-buckets>
ACERVO_SIEEJ_ACCESS_KEY=sieej-diccionarios-user
ACERVO_SIEEJ_SECRET_KEY=<rotada_por_init-buckets>

SECRET_KEY=<genera_con_secrets.token_urlsafe(32)>
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
CSRF_SECRET_KEY=<genera_con_secrets.token_urlsafe(32)>
CSRF_TOKEN_EXPIRE_MINUTES=60

COOKIE_NAME=access_token
COOKIE_MAX_AGE=1800
# Subdominio EXACTO donde viven mariachi y mapalab (no el dominio raiz).
COOKIE_DOMAIN=<subdomain>
COOKIE_SECURE=true
COOKIE_HTTPONLY=true
COOKIE_SAMESITE=strict

CORS_ORIGINS=["https://<domain>"]

PROJECT_NAME="Mariachi"
VERSION="0.17.0"
ADMIN_PREFIX=/api/administrador
WEB_PREFIX=/api/portal

ADMIN_USERNAME=<admin_username>
ADMIN_PASSWORD=<admin_password>
ADMIN_EMAIL=<admin_email>

VITE_NODE_ENV=production
VITE_GOOGLE_ANALYTICS_ID=<GA_ID>
VITE_ADMIN_APP_NAME="Mariachi"
VITE_ADMIN_API_URL=https://<domain>/api/administrador
VITE_ADMIN_API_TIMEOUT=10000

# Sentry (opcional; si vacio no se inicializa)
VITE_SENTRY_DSN=
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
