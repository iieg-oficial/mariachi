COMPOSE_PROJECT_NAME=mariachi-dev
ENVIRONMENT=development

API_PORT=<port>
ADMIN_PORT=<port>

POSTGRES_USER=<user>
POSTGRES_PASSWORD=<password>
POSTGRES_DB=<db_name>
DATABASE_URL=postgresql://<user>:<password>@<postgres_host>:<port>/<db_name>

# DataEngine (solo para modulo de capas de MapaLab)
DATAENGINE_DATABASE_URL=postgresql://<user>:<password>@<dataengine_host>:<port>/<db_name>
DATAENGINE_POOL_SIZE=5
DATAENGINE_MAX_OVERFLOW=5

# GeoServer REST
GEOSERVER_URL=http://<geoserver_host>:<port>/geoserver/
GEOSERVER_USER=<user>
GEOSERVER_PASSWORD=<password>
GEOSERVER_TIMEOUT=10.0

REDIS_URL=redis://<redis_host>:<port>/0

ACERVO_ENDPOINT=<acervo_host>:<port>
ACERVO_PUBLIC_ENDPOINT=<acervo_public_host>:<port>
ACERVO_ACCESS_KEY=<access_key>
ACERVO_SECRET_KEY=<secret_key>
ACERVO_BUCKET_NAME=<bucket_name>
ACERVO_USE_SSL=false
ACERVO_VERIFY_SSL=false

# Credenciales por bucket (fallback a ACERVO_ACCESS_KEY/SECRET_KEY si vacias)
ACERVO_PORTAL_ACCESS_KEY=
ACERVO_PORTAL_SECRET_KEY=
ACERVO_MAPALAB_ACCESS_KEY=
ACERVO_MAPALAB_SECRET_KEY=
ACERVO_DATEENGINE_ACCESS_KEY=
ACERVO_DATEENGINE_SECRET_KEY=

SECRET_KEY=<genera_con_secrets.token_urlsafe(32)>
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
CSRF_SECRET_KEY=<genera_con_secrets.token_urlsafe(32)>
CSRF_TOKEN_EXPIRE_MINUTES=60

COOKIE_NAME=access_token
COOKIE_MAX_AGE=1800
COOKIE_DOMAIN=
COOKIE_SECURE=false
COOKIE_HTTPONLY=true
COOKIE_SAMESITE=lax

CORS_ORIGINS=["http://<host>:<admin_port>","http://<host>:<portal_port>"]

PROJECT_NAME="Mariachi Dev"
VERSION="1.0.0"
ADMIN_PREFIX=/api/administrador
WEB_PREFIX=/api/portal
MAPALAB_PUBLIC_PREFIX=/api/mapalab
DOCS_URL=/docs
REDOC_URL=/redoc
OPENAPI_URL=/openapi.json

VITE_NODE_ENV=development
VITE_GOOGLE_ANALYTICS_ID=<GA_ID_or_empty>
VITE_ADMIN_PORT=<port>
VITE_ADMIN_HOST=<host>
VITE_ADMIN_APP_NAME="Mariachi Dev"
VITE_ADMIN_API_URL=http://<api_host>:<port>/api/administrador
VITE_ADMIN_API_TIMEOUT=10000

# URL del frontend de MapaLab para el proxy Vite del admin en dev.
VITE_MAPALAB_PROXY_URL=http://<mapalab_frontend_host>:<port>

# URL del backend de MapaLab al que mariachi-api notifica refresh-cache.
# Si queda vacio, layer_tree_cache no se invalida hasta el cron diario.
MAPALAB_BACKEND_URL=http://<mapalab_backend_host>:<port>

ADMIN_USERNAME=<admin_username>
ADMIN_PASSWORD=<admin_password>
ADMIN_EMAIL=<admin_email>

CREATE_SAMPLE_USERS=true
SAMPLE_EDITORA_PASSWORD=<password>
SAMPLE_DISENADORA_PASSWORD=<password>

# Sentry (opcional; si vacio no se inicializa)
VITE_SENTRY_DSN=
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=1.0
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
