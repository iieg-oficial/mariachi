COMPOSE_PROJECT_NAME=mariachi-staging
ENVIRONMENT=staging

POSTGRES_USER=usuario_base_datos_staging
POSTGRES_PASSWORD=contraseña_segura_staging
POSTGRES_DB=iieg_portal
DATABASE_URL=postgresql://usuario:password@postgres:5432/iieg_portal

# DataEngine (solo para modulo de capas de MapaLab)
DATAENGINE_DATABASE_URL=postgresql://mariachi_layers:password@dataengine-host:5432/dataengine_db
DATAENGINE_POOL_SIZE=5
DATAENGINE_MAX_OVERFLOW=5

# GeoServer REST (solo para modulo de capas de MapaLab)
GEOSERVER_URL=https://staging.tu-dominio.com/geoserver/
GEOSERVER_USER=admin
GEOSERVER_PASSWORD=
GEOSERVER_TIMEOUT=10.0

# URL interna del backend de mapalab para invalidar el cache del arbol.
MAPALAB_BACKEND_URL=http://mapalab-backend:8000

REDIS_URL=redis://redis:6379/0

ACERVO_HOST_IP=ip_servidor_acervo
ACERVO_ENDPOINT=ip_servidor_acervo
ACERVO_PUBLIC_ENDPOINT=staging.tu-dominio.com/acervo
ACERVO_ACCESS_KEY=usuario_acervo
ACERVO_SECRET_KEY=contraseña_acervo
ACERVO_BUCKET_NAME=mariachi-staging
ACERVO_USE_SSL=true
ACERVO_VERIFY_SSL=true

SECRET_KEY=genera_con_python_secrets.token_urlsafe(32)
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
CSRF_SECRET_KEY=genera_diferente_a_secret_key
CSRF_TOKEN_EXPIRE_MINUTES=60

COOKIE_NAME=access_token
COOKIE_MAX_AGE=1800
# Usar el subdominio EXACTO de staging. El gateway arriba se encarga de aislar subdominios.
COOKIE_DOMAIN=staging.tu-dominio.com
COOKIE_SECURE=true
COOKIE_HTTPONLY=true
COOKIE_SAMESITE=lax

CORS_ORIGINS=["https://staging.tu-dominio.com"]

PROJECT_NAME="Mariachi Staging"
VERSION="0.9.0"
ADMIN_PREFIX=/api/administrador
WEB_PREFIX=/api/portal

ADMIN_USERNAME=admin
ADMIN_PASSWORD=contraseña_admin_staging
ADMIN_EMAIL=admin@staging.tu-dominio.com

VITE_NODE_ENV=staging
VITE_APP_NAME="Portal Staging"
VITE_WEB_API_URL=https://staging.tu-dominio.com/api/portal
VITE_API_TIMEOUT=10000
VITE_GOOGLE_ANALYTICS_ID=
VITE_ADMIN_APP_NAME="Admin Staging"
VITE_ADMIN_API_URL=https://staging.tu-dominio.com/api/administrador
VITE_ADMIN_API_TIMEOUT=10000
