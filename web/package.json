{
    "name": "portal-web",
    "description": "Portal web del Instituto de Información Estadística y Geográfica de Jalisco (IIEG)",
    "license": "MIT",
    "author": "Edgar Alejandro Villarreal Padilla <edgar.villarreal@iieg.gob.mx>",
    "version": "0.15.0",
    "private": true,
    "type": "module",
    "scripts": {
        "prepare": "cd .. && git config core.hooksPath .githooks 2>/dev/null || true",
        "dev": "vite",
        "build": "vite build",
        "preview": "vite preview",
        "lint": "eslint .",
        "test": "vitest run",
        "test:ui": "vitest --ui",
        "test:coverage": "vitest run --coverage",
        "check:dead-code": "knip --no-exit-code",
        "check:dead-code:strict": "knip"
    },
    "lint-staged": {
        "*.{js,jsx}": "eslint --max-warnings=0"
    },
    "dependencies": {
        "@sentry/react": "^10.49.0",
        "axios": "1.13.3",
        "react": "19.2.5",
        "react-dom": "19.2.5",
        "react-ga4": "2.1.0",
        "react-router": "7.14.2"
    },
    "devDependencies": {
        "@eslint/js": "10.0.1",
        "@sentry/vite-plugin": "^5.2.0",
        "@tailwindcss/postcss": "4.1.18",
        "@testing-library/dom": "10.4.1",
        "@testing-library/jest-dom": "6.9.1",
        "@testing-library/react": "16.3.2",
        "@types/react": "19.2.14",
        "@types/react-dom": "19.2.3",
        "@vitejs/plugin-react": "5.2.0",
        "@vitest/coverage-v8": "4.1.5",
        "@vitest/ui": "4.1.5",
        "autoprefixer": "10.4.23",
        "eslint": "10.2.1",
        "eslint-plugin-jsx-a11y": "^6.10.2",
        "eslint-plugin-react-hooks": "7.1.1",
        "eslint-plugin-react-refresh": "0.5.2",
        "globals": "17.4.0",
        "happy-dom": "^20.9.0",
        "knip": "^6.6.0",
        "lint-staged": "^16.4.0",
        "postcss": "8.5.6",
        "rollup-plugin-visualizer": "^7.0.1",
        "tailwindcss": "4.1.18",
        "vite": "7.3.2",
        "vitest": "4.1.5"
    },
    "overrides": {
        "eslint-plugin-react-hooks": {
            "eslint": "$eslint"
        },
        "eslint-plugin-jsx-a11y": {
            "eslint": "$eslint"
        }
    }
}
