COMPOSE_PROJECT_NAME=mariachi-dev
ENVIRONMENT=development

API_PORT=8000
WEB_PORT=3010
ADMIN_PORT=3011

POSTGRES_USER=iieg_user
POSTGRES_PASSWORD=iieg_password
POSTGRES_DB=iieg_portal
DATABASE_URL=postgresql://iieg_user:iieg_password@localhost:5432/iieg_portal

# DataEngine (solo para modulo de capas de MapaLab - v1.4.0+)
# Apunta a la replica local de DataEngine cuando este disponible
DATAENGINE_DATABASE_URL=
DATAENGINE_POOL_SIZE=5
DATAENGINE_MAX_OVERFLOW=5

# GeoServer REST (solo para modulo de capas de MapaLab)
GEOSERVER_URL=http://host.docker.internal:8080/geoserver/
GEOSERVER_USER=admin
GEOSERVER_PASSWORD=
GEOSERVER_TIMEOUT=10.0

REDIS_URL=redis://localhost:6379/0

ACERVO_ENDPOINT=host.docker.internal:9000
ACERVO_PUBLIC_ENDPOINT=localhost:9000
ACERVO_ACCESS_KEY=minioadmin
ACERVO_SECRET_KEY=minioadmin
ACERVO_BUCKET_NAME=portal-dev
ACERVO_USE_SSL=false

SECRET_KEY=clave_desarrollo_no_usar_en_produccion
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
CSRF_SECRET_KEY=csrf_desarrollo_no_usar_en_produccion
CSRF_TOKEN_EXPIRE_MINUTES=60

COOKIE_NAME=access_token
COOKIE_MAX_AGE=1800
COOKIE_DOMAIN=
COOKIE_SECURE=false
COOKIE_HTTPONLY=true
COOKIE_SAMESITE=lax

CORS_ORIGINS=["http://localhost:3010","http://localhost:3011"]

PROJECT_NAME="Portal IIEG Dev"
VERSION="1.0.0"
ADMIN_PREFIX=/api/administrador
WEB_PREFIX=/api/portal
DOCS_URL=/docs
REDOC_URL=/redoc
OPENAPI_URL=/openapi.json

VITE_NODE_ENV=development
VITE_WEB_PORT=3010
VITE_WEB_HOST=localhost
VITE_APP_NAME=Portal Dev
VITE_WEB_API_URL=http://localhost:8000/api/portal
VITE_API_TIMEOUT=10000
VITE_GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX
VITE_ADMIN_PORT=3011
VITE_ADMIN_HOST=localhost
VITE_ADMIN_APP_NAME=Admin Dev
VITE_ADMIN_API_URL=http://localhost:8000/api/administrador
VITE_ADMIN_API_TIMEOUT=10000

# Proxy para el editor de capas MapaLab desde el admin en dev.
# El hook `useLayerTreeAdmin` llama a /mapalab/api/layers/tree (ruta relativa).
# En prod lo sirve el gateway-hub; en dev Vite proxea hacia el contenedor mapalab
# via la red docker externa `mapalab-network` (definida en docker-compose.dev.yml).
VITE_MAPALAB_PROXY_URL=http://mapalab-dev-frontend-1:3006

# Backend de MapaLab al que mariachi-api notifica refresh-cache tras cada CRUD
# de layers. Si esta vacio, `mapalab.layer_tree_cache` queda stale hasta el
# cron diario y el editor parece "no aplicar los cambios". Dev: mapalab-backend
# corre en network_mode: host → usamos host.docker.internal:8001. En prod es
# el hostname/DNS del server de mapalab.
MAPALAB_BACKEND_URL=http://host.docker.internal:8001

ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
ADMIN_EMAIL=admin@localhost

CREATE_SAMPLE_USERS=true
SAMPLE_EDITORA_PASSWORD=editora123
SAMPLE_DISENADORA_PASSWORD=disenadora123
