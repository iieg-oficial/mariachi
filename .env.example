COMPOSE_PROJECT_NAME=portal
ENV=production

POSTGRES_USER=usuario_base_datos
POSTGRES_PASSWORD=contraseña_segura_base_datos
POSTGRES_DB=nombre_base_datos
DATABASE_URL=postgresql://usuario:password@postgres:5432/db_name

REDIS_URL=redis://redis:6379/0

ACERVO_HOST_IP=ip_servidor_acervo
ACERVO_ENDPOINT=ip_servidor_acervo
ACERVO_PUBLIC_ENDPOINT=dominio.com/acervo
ACERVO_ACCESS_KEY=usuario_acervo
ACERVO_SECRET_KEY=contraseña_acervo
ACERVO_BUCKET_NAME=nombre_bucket
ACERVO_USE_SSL=true

SECRET_KEY=genera_con_python_secrets.token_urlsafe(32)
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
CSRF_SECRET_KEY=genera_diferente_a_secret_key
CSRF_TOKEN_EXPIRE_MINUTES=60

COOKIE_NAME=access_token
COOKIE_MAX_AGE=1800
COOKIE_DOMAIN=dominio.com
COOKIE_SECURE=true
COOKIE_HTTPONLY=true
COOKIE_SAMESITE=lax

CORS_ORIGINS=["https://dominio.com","https://s3.dominio.com"]

PROJECT_NAME="Nombre Proyecto"
VERSION="1.0.0"
ADMIN_PREFIX=/api/administrador
WEB_PREFIX=/api/portal

ADMIN_USERNAME=admin
ADMIN_PASSWORD=contraseña_admin_segura
ADMIN_EMAIL=admin@dominio.com

VITE_NODE_ENV=production
VITE_APP_NAME=Portal
VITE_WEB_API_URL=https://dominio.com/api/portal
VITE_API_TIMEOUT=10000
VITE_GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX
VITE_ADMIN_APP_NAME=Admin
VITE_ADMIN_API_URL=https://dominio.com/api/administrador
VITE_ADMIN_API_TIMEOUT=10000
