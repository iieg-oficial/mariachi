COMPOSE_PROJECT_NAME=nombre_del_proyecto_docker

POSTGRES_PORT=puerto_postgres
REDIS_PORT=puerto_redis

API_PORT=puerto_backend
WEB_PORT=puerto_frontend
ADMIN_PORT=puerto_cms

POSTGRES_USER=usuario_base_datos
POSTGRES_PASSWORD=contraseña_segura_base_datos
POSTGRES_DB=nombre_base_datos
DATABASE_URL=postgresql://usuario:password@host:port/db_name

REDIS_URL=redis://host:port/db_index

MINIO_ENDPOINT=ip_o_dominio_servidor_minio:9000
MINIO_PUBLIC_ENDPOINT=cdn.dominio.com
MINIO_ACCESS_KEY=usuario_admin_minio
MINIO_SECRET_KEY=contraseña_segura_minio
MINIO_BUCKET_NAME=nombre_bucket_archivos
MINIO_USE_SSL=true_o_false

SECRET_KEY=string_aleatorio_seguro_para_jwt
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=tiempo_expiracion_minutos
CSRF_SECRET_KEY=string_aleatorio_dieferente_para_csrf
CSRF_TOKEN_EXPIRE_MINUTES=tiempo_expiracion_csrf

COOKIE_NAME=nombre_cookie_auth
COOKIE_MAX_AGE=tiempo_vida_cookie_segundos
COOKIE_SECURE=true_para_https
COOKIE_HTTPONLY=true
COOKIE_SAMESITE=lax_strict_o_none

CORS_ORIGINS=["https://dominio1.com","https://dominio2.com"]

PROJECT_NAME="Nombre del Proyecto Backend"
VERSION="1.0.0"
ADMIN_PREFIX=/prefijo/api/admin
WEB_PREFIX=/prefijo/api/web
DOCS_URL=/ruta_documentacion

VITE_WEB_PORT=puerto_vite_web
VITE_WEB_HOST=host_vite_web
VITE_WEB_API_URL=url_completa_api_backend

VITE_ADMIN_PORT=puerto_vite_admin
VITE_ADMIN_HOST=host_vite_admin
VITE_ADMIN_API_URL=url_completa_api_backend

VITE_GOOGLE_ANALYTICS_ID=id_google_analytics
VITE_SENTRY_DSN=url_dsn_sentry

NGINX_PORT=puerto_nginx

ADMIN_USERNAME=usuario_admin_inicial_db
ADMIN_PASSWORD=password_admin_inicial_db
ADMIN_EMAIL=email_admin_inicial_db

CREATE_SAMPLE_USERS=true_o_false
SAMPLE_EDITORA_PASSWORD=password_usuario_prueba
SAMPLE_DISENADORA_PASSWORD=password_usuario_prueba
