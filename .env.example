COMPOSE_PROJECT_NAME=mariachi
ENVIRONMENT=production

POSTGRES_USER=usuario_base_datos
POSTGRES_PASSWORD=contraseña_segura_base_datos
POSTGRES_DB=nombre_base_datos
DATABASE_URL=postgresql://usuario:password@postgres:5432/db_name

# DataEngine (solo para modulo de capas de MapaLab)
# Requiere credenciales con permisos read/write sobre las tablas layers, workspaces, initial_layer_order
DATAENGINE_DATABASE_URL=postgresql://mariachi_layers:password@dataengine-host:5432/dataengine_db
DATAENGINE_POOL_SIZE=5
DATAENGINE_MAX_OVERFLOW=5

# GeoServer REST (solo para modulo de capas de MapaLab)
# Se usa para introspeccion: workspaces disponibles, capas por workspace, campos y estilos.
GEOSERVER_URL=https://dominio.com/geoserver/
GEOSERVER_USER=admin
GEOSERVER_PASSWORD=
GEOSERVER_TIMEOUT=10.0

# URL interna del backend de mapalab para invalidar el cache del arbol al aprobar
# borradores o editar capas. Deja vacio para desactivar notificaciones.
MAPALAB_BACKEND_URL=http://mapalab-backend:8000

REDIS_URL=redis://redis:6379/0

ACERVO_HOST_IP=ip_servidor_acervo
ACERVO_ENDPOINT=ip_servidor_acervo
ACERVO_PUBLIC_ENDPOINT=dominio.com/acervo
ACERVO_ACCESS_KEY=usuario_acervo
ACERVO_SECRET_KEY=contraseña_acervo
ACERVO_BUCKET_NAME=nombre_bucket
ACERVO_USE_SSL=<true or false>
ACERVO_VERIFY_SSL=<true or false>

SECRET_KEY=genera_con_python_secrets.token_urlsafe(32)
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
CSRF_SECRET_KEY=genera_diferente_a_secret_key
CSRF_TOKEN_EXPIRE_MINUTES=60

COOKIE_NAME=access_token
COOKIE_MAX_AGE=1800
# COOKIE_DOMAIN debe ser el subdominio EXACTO donde viven mariachi y mapalab.
# Usar el subdominio especifico (ej. app.tu-dominio.com), NO el dominio raiz,
# para no exponer la cookie a otros subdominios.
# La cookie con este domain es valida para /administrador/* y /mapalab/* — auth compartida entre CMS y visor.
COOKIE_DOMAIN=app.tu-dominio.com
COOKIE_SECURE=true
COOKIE_HTTPONLY=true
COOKIE_SAMESITE=lax

CORS_ORIGINS=["https://dominio.com","https://s3.dominio.com"]

PROJECT_NAME="Nombre Proyecto"
VERSION="1.0.0"
ADMIN_PREFIX=/api/administrador
WEB_PREFIX=/api/portal

ADMIN_USERNAME=admin
ADMIN_PASSWORD=contraseña_admin_segura
ADMIN_EMAIL=admin@dominio.com

VITE_NODE_ENV=production
VITE_APP_NAME=Portal
VITE_WEB_API_URL=https://dominio.com/api/portal
VITE_API_TIMEOUT=10000
VITE_GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX
VITE_ADMIN_APP_NAME=Admin
VITE_ADMIN_API_URL=https://dominio.com/api/administrador
VITE_ADMIN_API_TIMEOUT=10000

# Sentry (opcional; si vacio no se inicializa)
# VITE_SENTRY_DSN: DSN publico para el frontend (admin y web)
# SENTRY_DSN: DSN para el backend FastAPI
# SENTRY_AUTH_TOKEN / SENTRY_ORG / SENTRY_PROJECT: solo se usan en build para subir sourcemaps
VITE_SENTRY_DSN=
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
