ENVIRONMENT=production
API_ENV_FILE=./.env.production
GUNICORN_WORKERS=8
POSTGRES_MAX_CONNECTIONS=200
POSTGRES_SHARED_BUFFERS=512MB
POSTGRES_EFFECTIVE_CACHE_SIZE=2GB

POSTGRES_USER=<user>
POSTGRES_DB=<db_name>

DATAENGINE_DATABASE_URL=postgresql://<user>:<password>@<dataengine_host>:<port>/<db_name>?sslmode=require

GEOSERVER_URL=https://<domain>/sextante/
GEOSERVER_USER=<user>
GEOSERVER_PASSWORD=<password>
# Staging en disco de las subidas por partes a GeoServer (rasters, tipografias).
# GEOSERVER_UPLOAD_MAX_BYTES=0 significa sin tope: el techo es el disco de la VM.
GEOSERVER_UPLOAD_STAGING_DIR=/var/tmp/geoserver-uploads
GEOSERVER_UPLOAD_MAX_BYTES=0
GEOSERVER_INSTALLED_FONT_FAMILIES=Garet

ACERVO_ENDPOINT=<acervo_host>:<port>
ACERVO_PUBLIC_ENDPOINT=/acervo
ACERVO_USE_SSL=false
ACERVO_VERIFY_SSL=true

ACERVO_PORTAL_ACCESS_KEY=portal-user
ACERVO_PORTAL_SECRET_KEY=<rotada_por_init-buckets>
ACERVO_MAPALAB_ACCESS_KEY=mapalab-user
ACERVO_MAPALAB_SECRET_KEY=<rotada_por_init-buckets>
ACERVO_MARIACHI_ACCESS_KEY=mariachi-user
ACERVO_MARIACHI_SECRET_KEY=<rotada_por_init-buckets>
ACERVO_SIEEJ_ACCESS_KEY=sieej-user
ACERVO_SIEEJ_SECRET_KEY=<rotada_por_init-buckets>
ACERVO_IIEG_ACCESS_KEY=iieg-user
ACERVO_IIEG_SECRET_KEY=<rotada_por_init-buckets>


COOKIE_DOMAIN=<subdomain>
COOKIE_SAMESITE=strict

CORS_ORIGINS=["https://<domain>"]

ADMIN_USERNAME=<admin_username>
ADMIN_PASSWORD=<admin_password>
ADMIN_EMAIL=<admin_email>

MAPALAB_BACKEND_URL=http://<mapalab_backend_host>:<port>
MAPALAB_INTERNAL_TOKEN=<genera_con_secrets.token_urlsafe(32)>

# Token para subida interna al Acervo desde plataformas externas (Portal). Solo bucket `portal`.
ACERVO_INTERNAL_TOKEN=<genera_con_secrets.token_urlsafe(32)>

DISCORD_WEBHOOK_MAPALAB=
DISCORD_WEBHOOK_SIEEJ=
DISCORD_WEBHOOK_PORTAL=

SIEEJ_URL=

# Colibri (botón "Reportar" en cards de plataformas del Inicio del admin).
# Crear o rotar la api-key del source-app "mariachi" desde /colibri/source-apps,
# y pegar el valor aquí. Si queda vacío, el botón no se renderiza.
COLIBRI_API_KEY_MARIACHI=

VITE_WEB_URL=https://<domain>

VITE_NODE_ENV=production
VITE_ADMIN_API_URL=/api/mariachi
CRON_SIEEJ_EXPIRE_INTERVAL=3600

# Monitor ligero de huachicol (estado del ecosistema via /ontoy)
HUACHICOL_MONITOR_URL=http://huachicol-monitor:8090

WACHA_ENABLED=false
WACHA_API_URL=<http://IP:PUERTO de la API de wacha; solo en el nodo donde vive>
WACHA_TIMEOUT=10

# Estadisticas de vine (schema vine). Apagado deja el router sin registrar (404)
# y oculta la seccion del CMS. VITE_VINE_ENABLED viaja en el build del admin.
VINE_ENABLED=false
VITE_VINE_ENABLED=false
VINE_BIOMETRICO_URL=<postgresql://usuario:password@IP:5432/security_db del BioTime, solo lectura>
VINE_BIOMETRICO_TIMEOUT=5

# Minerva (SSO). MINERVA_ISSUER_URL es la URL con que la alcanza el backend;
# MINERVA_PUBLIC_URL la que alcanza el navegador (vacia si son la misma).
# MINERVA_REDIRECT_URI debe coincidir EXACTA con la registrada en minerva.
MINERVA_ISSUER_URL=<url_interna_de_minerva>
MINERVA_PUBLIC_URL=<url_publica_de_minerva>
MINERVA_APPLICATION_CODE=mariachi
MINERVA_CLIENT_ID=<client_id_de_la_app_en_minerva>
MINERVA_CLIENT_SECRET=<client_secret_de_la_app_en_minerva>
MINERVA_REDIRECT_URI=<url_publica_de_mariachi>/api/mariachi/autenticacion/callback
# Panel de minerva (su FRONTEND, no el backend): de aqui sale la URL de cierre de
# sesion, {esta_url}/logout. Si queda vacia cae al backend, que no tiene esa ruta
# y el logout deja viva la sesion del SSO.
MINERVA_LOGIN_URL=<url_publica_del_panel_de_minerva>
MINERVA_POST_LOGIN_URL=<url_publica_del_admin>

# POSTGRES_PASSWORD, SECRET_KEY y CSRF_SECRET_KEY viven en secrets/, no aqui.
# Plantillas: secrets/*.example. Ver ecosistema/compose.md.
