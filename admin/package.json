{
    "name": "mariachi-admin",
    "description": "Mariachi — panel de administración del ecosistema IIEG",
    "license": "MIT",
    "author": "Edgar Alejandro Villarreal Padilla <edgar.villarreal@iieg.gob.mx>",
    "version": "0.51.1",
    "private": true,
    "type": "module",
    "scripts": {
        "prepare": "cd .. && git config core.hooksPath .githooks 2>/dev/null || true",
        "dev": "vite",
        "build": "vite build",
        "preview": "vite preview",
        "lint": "eslint .",
        "test": "vitest run",
        "test:ui": "vitest --ui",
        "test:coverage": "vitest run --coverage",
        "check:dead-code": "knip --no-exit-code",
        "check:dead-code:strict": "knip"
    },
    "lint-staged": {
        "*.{js,jsx}": "eslint --max-warnings=0"
    },
    "dependencies": {
        "@ant-design/icons": "6.1.0",
        "@dnd-kit/core": "^6.3.1",
        "@dnd-kit/sortable": "^10.0.0",
        "@dnd-kit/utilities": "^3.2.2",
        "@sentry/react": "^10.49.0",
        "antd": "6.2.2",
        "axios": "1.13.3",
        "dayjs": "^1.11.20",
        "ol": "^10.9.0",
        "proj4": "^2.20.8",
        "react": "19.2.5",
        "react-dom": "19.2.5",
        "react-router": "7.14.2"
    },
    "devDependencies": {
        "@eslint/js": "10.0.1",
        "@sentry/vite-plugin": "^5.2.0",
        "@testing-library/dom": "10.4.1",
        "@testing-library/jest-dom": "6.9.1",
        "@testing-library/react": "16.3.2",
        "@types/react": "19.2.14",
        "@types/react-dom": "19.2.3",
        "@vitejs/plugin-react": "5.2.0",
        "@vitest/coverage-v8": "4.1.5",
        "@vitest/ui": "4.1.5",
        "eslint": "10.2.1",
        "eslint-plugin-jsx-a11y": "^6.10.2",
        "eslint-plugin-react-hooks": "7.1.1",
        "eslint-plugin-react-refresh": "0.5.2",
        "globals": "17.4.0",
        "happy-dom": "^20.9.0",
        "knip": "^6.6.0",
        "lint-staged": "^16.4.0",
        "msw": "2.12.7",
        "rollup-plugin-visualizer": "^7.0.1",
        "vite": "7.3.2",
        "vitest": "4.1.5"
    },
    "overrides": {
        "eslint-plugin-react-hooks": {
            "eslint": "$eslint"
        },
        "eslint-plugin-jsx-a11y": {
            "eslint": "$eslint"
        }
    },
    "msw": {
        "workerDirectory": [
            "public"
        ]
    }
}
